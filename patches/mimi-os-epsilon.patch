+def icon_calculation(c):
+    tile(c, *PALETTES["pink"])
+    ink = hexc(PINK_DARK)
+    for i in range(4):
+        cx = 37 + (i % 2) * 26
+        cy = 49 + (i // 2) * 24
+        c.circle(cx, cy, 11, fill=hexc(0xFFFFFF, 240))
+        if i in (0, 1):
+            c.line([(cx - 5.5, cy), (cx + 5.5, cy)], 3.4, fill=ink)
+        if i == 0:
+            c.line([(cx, cy - 5.5), (cx, cy + 5.5)], 3.4, fill=ink)
+        if i == 2:
+            c.line([(cx - 4.5, cy - 4.5), (cx + 4.5, cy + 4.5)], 3.4, fill=ink)
+            c.line([(cx - 4.5, cy + 4.5), (cx + 4.5, cy - 4.5)], 3.4, fill=ink)
+        if i == 3:
+            c.line([(cx - 5.5, cy), (cx + 5.5, cy)], 3.4, fill=ink)
+            c.circle(cx, cy - 5, 1.9, fill=ink)
+            c.circle(cx, cy + 5, 1.9, fill=ink)
+    tile_clip(c)
+
+
+def icon_graph(c):
+    tile(c, *PALETTES["berry"])
+    c.line([(24, 86), (24, 38)], 3, fill=hexc(0xFFFFFF, 150))
+    c.line([(20, 70), (82, 70)], 3, fill=hexc(0xFFFFFF, 150))
+    pts = [(22 + i * 1.3, 64 - 18 * math.sin(i * 1.3 / 58 * math.pi * 2)) for i in range(46)]
+    c.line(pts, 6)
+    tile_clip(c)
+
+
+def icon_solver(c):
+    tile(c, *PALETTES["lilac"])
+    outlined_text(c, 50, 58, "x=?", 26)
+    tile_clip(c)
