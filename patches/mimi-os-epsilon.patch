+void disc(Band& b, int cx, int cy, int r, KDColor c, int alpha) {
+  roundFill(b, {cx - r, cy - r, 2 * r, 2 * r}, r, c, alpha);
+}
+
+void ellipse(Band& b, Rect r, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  /* Coverage from the normalised squared distance: near the edge,
+   * 1 - d is about (1 - d^2) / 2, antialiased on about one pixel. */
+  float rx = r.w / 2.f, ry = r.h / 2.f;
+  float cx = r.x + rx, cy = r.y + ry;
+  float scale = (rx < ry ? rx : ry) / 2.f;  // 1 - d^2 -> pixels
+  float irx = 1.f / rx, iry = 1.f / ry;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    float dy = (y + 0.5f - cy) * iry;
+    float dy2 = dy * dy;
+    if (dy2 >= 1.f + 1.f / scale) {
+      continue;
+    }
+    for (int x = z.x; x < z.right(); x++) {
+      float dx = (x + 0.5f - cx) * irx;
+      float edge = (1.f - dx * dx - dy2) * scale + 0.5f;
+      if (edge <= 0.f) {
+        continue;
+      }
+      int cov = edge >= 1.f ? 256 : static_cast<int>(edge * 256);
+      blendPixel(row + x, c, (alpha * cov) >> 8);
+    }
+  }
+}
+
+void vgradient(Band& b, Rect r, KDColor top, KDColor bottom) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    int t = r.h > 1 ? (y - r.y) * 255 / (r.h - 1) : 0;
+    KDColor c = KDColor::Blend(bottom, top, static_cast<uint8_t>(t));
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      row[x] = c;
+    }
+  }
+}
+
+void gameIcon(Band& b, const Ion::ExternalApps::App& app, int x, int y,
+              int size) {
+  Rect z = Rect{x, y, size, size}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  const uint8_t* data = app.iconData();
+  uint32_t dataSize = app.iconSize();
+  if (data == nullptr || dataSize == 0) {
+    image(b, MimiIcons::IconGame, x, y, size);
+    return;
+  }
+  OMG::Memory::Decompress(data, reinterpret_cast<uint8_t*>(s_textBuffer),
+                          dataSize,
+                          k_nwaIconWidth * k_nwaIconHeight * sizeof(KDColor));
+  // Rounded corners like the other tiles
+  Rect r = {x, y, size, size};
+  int radius = size / 5;
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src =
+        s_textBuffer + ((yy - y) * k_nwaIconHeight / size) * k_nwaIconWidth;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int cov = roundCoverage(r, radius, xx, yy);
+      if (cov) {
+        blendPixel(row + xx, src[(xx - x) * k_nwaIconWidth / size], cov);
+      }
+    }
+  }
+}
