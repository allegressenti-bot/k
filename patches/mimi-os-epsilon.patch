+
+def rgb565(r, g, b):
+    return ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3)
+
+
+def main():
+    out = sys.argv[1]
+    preview = None
+    if "--preview" in sys.argv:
+        preview = sys.argv[sys.argv.index("--preview") + 1]
+    images = []
+    for name, fn, size in PICTURES:
+        c = Canvas()
+        fn(c)
+        images.append((name, c.render(size)))
+    lines = [
+        "// Generated by apps/home/mimi/gen_icons.py - do not edit",
+        "#pragma once",
+        "#include <stdint.h>",
+        "",
+        "namespace Home {",
+        "namespace MimiIcons {",
+        "",
+        "struct Image {",
+        "  uint8_t width;",
+        "  uint8_t height;",
+        "  const uint16_t* colors;",
+        "  const uint8_t* alphas;",
+        "};",
+        "",
+        "enum Icon : uint8_t {",
+    ]
+    for i, (name, _) in enumerate(images):
+        lines.append(f"  Icon{name} = {i},")
+    lines += [f"  NumberOfIcons = {len(images)}", "};", ""]
+    for name, img in images:
+        px = img.load()
+        w, h = img.size
+        colors, alphas = [], []
+        for y in range(h):
+            for x in range(w):
+                r, g, b, a = px[x, y]
+                if a == 0:
+                    r = g = b = 0
+                colors.append(rgb565(r, g, b))
+                alphas.append(a)
+        lines.append(f"constexpr uint16_t k_{name}Colors[{w * h}] = {{")
+        for i in range(0, len(colors), 24):
+            lines.append("  " + ", ".join(str(v) for v in colors[i:i + 24]) + ",")
+        lines.append("};")
+        lines.append(f"constexpr uint8_t k_{name}Alphas[{w * h}] = {{")
+        for i in range(0, len(alphas), 32):
+            lines.append("  " + ", ".join(str(v) for v in alphas[i:i + 32]) + ",")
+        lines.append("};")
+    lines.append(f"constexpr Image k_images[{len(images)}] = {{")
+    for name, img in images:
+        w, h = img.size
+        lines.append(f"  {{{w}, {h}, k_{name}Colors, k_{name}Alphas}},")
+    lines += ["};", "", "}  // namespace MimiIcons", "}  // namespace Home", ""]
+    with open(out, "w") as f:
+        f.write("\n".join(lines))
+    if preview:
+        scale = 4
+        cols = 8
+        cell = 84
+        rows = (len(images) + cols - 1) // cols
+        sheet = Image.new("RGBA", (cols * cell * scale, rows * cell * scale), hexc(0xFFE6F0))
+        for i, (_, img) in enumerate(images):
+            big = img.resize((img.width * scale, img.height * scale), Image.NEAREST)
+            if img.width <= 12:
+                bg = Image.new("RGBA", big.size, hexc(PINK))
+                bg.alpha_composite(big)
+                big = bg
+            sheet.alpha_composite(big, ((i % cols) * cell * scale, (i // cols) * cell * scale))
+        sheet.save(preview)
+
+
+if __name__ == "__main__":
+    main()
