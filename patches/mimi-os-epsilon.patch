+    pts = [(18 + i * 2, 84 - 40 * math.exp(-(((18 + i * 2) - 50) / 13) ** 2)) for i in range(33)]
+    c.poly(pts + [(82, 84), (18, 84)], fill=hexc(0xFFFFFF, 110))
