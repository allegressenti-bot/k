+/* ------------------------------------------------------------ primitives */
+
+void fill(Band& b, Rect r, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    if (alpha >= 256) {
+      for (int x = z.x; x < z.right(); x++) {
+        row[x] = c;
+      }
+    } else {
+      for (int x = z.x; x < z.right(); x++) {
+        blendPixel(row + x, c, alpha);
+      }
+    }
+  }
+}
+
+void frame(Band& b, Rect r, KDColor c, int alpha) {
+  fill(b, {r.x, r.y, r.w, 1}, c, alpha);
+  fill(b, {r.x, r.bottom() - 1, r.w, 1}, c, alpha);
+  fill(b, {r.x, r.y + 1, 1, r.h - 2}, c, alpha);
+  fill(b, {r.right() - 1, r.y + 1, 1, r.h - 2}, c, alpha);
+}
+
+/* Coverage (0..256) of the pixel (px, py) of a rounded rectangle, 0 outside.
+ * Only the corners are curved; they are antialiased on one pixel. No square
+ * root: near the edge, r - d is about (r^2 - d^2) / 2r. */
+static int roundCoverage(const Rect& r, int radius, int px, int py) {
+  int cx, cy;
+  if (px < r.x + radius) {
+    cx = r.x + radius;
+  } else if (px >= r.right() - radius) {
+    cx = r.right() - radius - 1;
+  } else {
+    return 256;
+  }
+  if (py < r.y + radius) {
+    cy = r.y + radius;
+  } else if (py >= r.bottom() - radius) {
+    cy = r.bottom() - radius - 1;
+  } else {
+    return 256;
+  }
+  // In half pixels, from the corner centre
+  int dx = 2 * (px - cx) + (px < cx ? 1 : -1);
+  int dy = 2 * (py - cy) + (py < cy ? 1 : -1);
+  int d2 = dx * dx + dy * dy;  // (2d)^2
+  int r2 = 2 * radius + 1;     // 2 (r + 0.5)
+  int outer = r2 * r2;
+  if (d2 >= outer) {
+    return 0;
+  }
+  int inner = (r2 - 2) * (r2 - 2);  // 2 (r - 0.5)
+  if (d2 <= inner) {
+    return 256;
+  }
+  return (outer - d2) * 256 / (outer - inner);
+}
+
+void roundFill(Band& b, Rect r, int radius, KDColor c, int alpha) {
+  if (radius <= 0) {
+    return fill(b, r, c, alpha);
+  }
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    bool cornerRow = y < r.y + radius || y >= r.bottom() - radius;
+    for (int x = z.x; x < z.right(); x++) {
+      int a = alpha;
+      if (cornerRow) {
+        int cov = roundCoverage(r, radius, x, y);
+        if (cov == 0) {
+          continue;
+        }
+        a = (alpha * cov) >> 8;
+      }
+      blendPixel(row + x, c, a);
+    }
+  }
+}
+
+void roundFrame(Band& b, Rect r, int radius, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  Rect inner = r.inset(1);
+  int innerRadius = radius > 1 ? radius - 1 : 0;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    bool cornerRow = y < r.y + radius || y >= r.bottom() - radius;
+    if (!cornerRow) {
+      // Straight sides: one pixel on each side
+      if (r.x >= z.x) {
+        blendPixel(row + r.x, c, alpha);
+      }
+      if (r.right() - 1 < z.right()) {
+        blendPixel(row + r.right() - 1, c, alpha);
+      }
+      continue;
+    }
+    for (int x = z.x; x < z.right(); x++) {
+      bool edgeRow = y == r.y || y == r.bottom() - 1;
+      bool inCorner = x < r.x + radius || x >= r.right() - radius;
+      if (!edgeRow && !inCorner) {
+        continue;
+      }
+      int outer = roundCoverage(r, radius, x, y);
+      if (outer == 0) {
+        continue;
+      }
+      int in = inner.contains(x, y) ? roundCoverage(inner, innerRadius, x, y)
+                                    : 0;
+      int cov = outer - in;
+      if (cov > 0) {
+        blendPixel(row + x, c, (alpha * cov) >> 8);
+      }
+    }
+  }
+}
+
+void shadow(Band& b, Rect r, int radius, int strength) {
+  roundFill(b, {r.x - 1, r.y + 2, r.w + 2, r.h + 1}, radius + 1, KDBlack,
+            strength / 3);
+}
+
+void image(Band& b, int icon, int x, int y, int size, int alpha) {
+  const MimiIcons::Image& im = MimiIcons::k_images[icon];
+  int w = im.width, h = im.height;
+  int dw = size > 0 ? size : w;
+  int dh = size > 0 ? size * h / w : h;
+  Rect z = Rect{x, y, dw, dh}.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  int step = (w << 16) / dw;
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    int sy = (yy - y) * h / dh;
+    const uint16_t* colors = im.colors + sy * w;
+    const uint8_t* alphas = im.alphas + sy * w;
+    int fx = (z.x - x) * step;
+    for (int xx = z.x; xx < z.right(); xx++, fx += step) {
+      int sx = fx >> 16;
+      int a = alphas[sx];
+      if (a) {
+        blendPixel(row + xx, KDColor::RGB16(colors[sx]),
+                   a == 255 ? alpha : (a * alpha) >> 8);
+      }
+    }
+  }
+}
+
+void tinted(Band& b, int icon, int x, int y, KDColor c, int alpha) {
+  const MimiIcons::Image& im = MimiIcons::k_images[icon];
+  Rect z = Rect{x, y, im.width, im.height}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const uint8_t* alphas = im.alphas + (yy - y) * im.width - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = alphas[xx];
+      if (a) {
+        blendPixel(row + xx, c, a == 255 ? alpha : (a * alpha) >> 8);
+      }
+    }
+  }
+}
