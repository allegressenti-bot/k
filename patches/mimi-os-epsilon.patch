+#pragma once
+
+/* Mimi-OS drawing primitives (the band renderer of Mint-OS and iOS-OS).
+ *
+ * The screen is composed in RAM one horizontal band at a time (background,
+ * tiles, text) and every finished band is pushed to the LCD in one go: no
+ * flicker, and redrawing a small dirty rectangle only costs that rectangle. */
+
+#include <ion/display.h>
+#include <ion/external_apps.h>
+#include <kandinsky/color.h>
+#include <kandinsky/font.h>
+#include <stdint.h>
+
+#include "mimi_icons.h"
+
+namespace Home {
+namespace Mimi {
+
+constexpr int k_screenWidth = Ion::Display::Width;
+constexpr int k_screenHeight = Ion::Display::Height;
+
+struct Rect {
+  int x, y, w, h;
+  int right() const { return x + w; }
+  int bottom() const { return y + h; }
+  bool isEmpty() const { return w <= 0 || h <= 0; }
+  bool contains(int px, int py) const {
+    return px >= x && py >= y && px < x + w && py < y + h;
+  }
+  bool intersects(const Rect& o) const {
+    return x < o.right() && o.x < right() && y < o.bottom() && o.y < bottom();
+  }
+  Rect intersection(const Rect& o) const;
+  Rect inset(int d) const { return {x + d, y + d, w - 2 * d, h - 2 * d}; }
+  Rect translated(int dx, int dy) const { return {x + dx, y + dy, w, h}; }
+};
+
+constexpr Rect k_screen = {0, 0, k_screenWidth, k_screenHeight};
+
+// The band being composed, and the clipping rectangle inside it
+class Band {
+ public:
+  constexpr static int k_maxHeight = 12;
+  void begin(Rect area);
+  const Rect& area() const { return m_area; }
+  const Rect& clip() const { return m_clip; }
+  // Restricts drawing to r (intersected with the band). Returns false if empty.
+  bool setClip(Rect r);
+  void resetClip() { m_clip = m_area; }
+  // Pointer to pixel (0, y) of the band, valid for x in [area.x, area.right)
+  KDColor* row(int y) const;
+  const KDColor* pixels() const;
+
+ private:
+  Rect m_area;
+  Rect m_clip;
+  KDColor* m_pixels;
+};
+
+
+enum class Align : uint8_t { Left, Center, Right };
+
+KDColor mix(uint32_t a, uint32_t b, int t256);
+void fill(Band& b, Rect r, KDColor c, int alpha = 256);
+void roundFill(Band& b, Rect r, int radius, KDColor c, int alpha = 256);
+void roundFrame(Band& b, Rect r, int radius, KDColor c, int alpha = 256);
+void frame(Band& b, Rect r, KDColor c, int alpha = 256);
+// Soft drop shadow around r
+void shadow(Band& b, Rect r, int radius, int strength);
+void disc(Band& b, int cx, int cy, int r, KDColor c, int alpha = 256);
+void ellipse(Band& b, Rect r, KDColor c, int alpha = 256);
+void vgradient(Band& b, Rect r, KDColor top, KDColor bottom);
+// Colour image from mimi_icons.h, at its size or scaled to size pixels wide
+void image(Band& b, int icon, int x, int y, int size = 0, int alpha = 256);
+// The alpha of an image, painted in one colour
+void tinted(Band& b, int icon, int x, int y, KDColor c, int alpha = 256);
+// Icon of an external app (.nwa), scaled to size x size
+void gameIcon(Band& b, const Ion::ExternalApps::App& app, int x, int y,
+              int size);
+// Text whose top-left corner is (x, y), cut at maxWidth pixels
+void text(Band& b, const char* s, int x, int y, KDColor c,
+          KDFont::Size font = KDFont::Size::Small, Align align = Align::Left,
+          int maxWidth = k_screenWidth);
+// Large font magnified scale times (titles)
+void bigText(Band& b, const char* s, int x, int y, KDColor c, int scale,
+             Align align = Align::Left);
+int textWidth(const char* s, KDFont::Size font = KDFont::Size::Small);
+int glyphWidth(KDFont::Size font = KDFont::Size::Small);
+int glyphHeight(KDFont::Size font = KDFont::Size::Small);
+
+// Large font magnified by scale64 / 64 (any size, not only whole numbers)
+void scaledText(Band& b, const char* s, int x, int y, KDColor c, int scale64,
+                Align align = Align::Left);
+int scaledTextWidth(const char* s, int scale64);
+/* Big numbers drawn with antialiased strokes (clocks, temperatures):
+ * digits, ':', ',', '.', '-' and the degree sign. h is the digit height. */
+void digits(Band& b, const char* s, int x, int y, int h, KDColor c,
+            Align align = Align::Left, int alpha = 256);
+int digitsWidth(const char* s, int h);
+// Antialiased thick segment
+void line(Band& b, float x0, float y0, float x1, float y1, float width,
+          KDColor c, int alpha = 256);
+/* Antialiased ring of radius r (to the middle of the stroke), from 12
+ * o'clock clockwise over fraction (0..1) of the turn */
+void ring(Band& b, float cx, float cy, float r, float width, float fraction,
+          KDColor c, int alpha = 256);
+// Darkens (alpha > 0) everything already in the band
+inline void dim(Band& b, int alpha) { fill(b, k_screen, KDColor::RGB24(0), alpha); }
+// Warm colours of Night Shift on the whole band
+void warmFilter(Band& b, int strength256);
+
+inline KDColor rgb(uint32_t c) { return KDColor::RGB24(c); }
+
+}  // namespace Mimi
+}  // namespace Home
