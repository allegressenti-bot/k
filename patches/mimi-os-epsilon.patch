+def art_wallpaper(c):
+    """80x80 tile, white shapes only: tinted pink at runtime."""
+    soft = hexc(0xFFFFFF)
+    # kitten head outlines (no face details: a quiet pattern)
+    def head(cx, cy, s):
+        o = hexc(0xFFFFFF)
+        w = 3.2
+        c.poly([(cx - 40 * s, cy - 6 * s), (cx - 34 * s, cy - 44 * s), (cx - 6 * s, cy - 28 * s)],
+               fill=None, outline=o, width=w)
+        c.poly([(cx + 40 * s, cy - 6 * s), (cx + 34 * s, cy - 44 * s), (cx + 6 * s, cy - 28 * s)],
+               fill=None, outline=o, width=w)
+        c.ellipse(cx - 42 * s, cy - 33 * s, cx + 42 * s, cy + 31 * s, fill=(0, 0, 0, 0), outline=o,
+                  width=w)
+        for ex in (cx - 17 * s, cx + 17 * s):
+            c.ellipse(ex - 4 * s, cy - 6 * s, ex + 4 * s, cy + 4 * s, fill=o)
+        heart(c, cx, cy + 9 * s, 4 * s, fill=o)
+    # the outlines must not erase what is below: draw on separate layers
+    base = c.img
+    for fn in (lambda: head(27, 32, 0.42), lambda: head(77, 84, 0.42),
+               lambda: head(-23, 84, 0.42), lambda: head(27, 132, 0.42),
+               lambda: head(127, 84, 0.42), lambda: head(77, -16, 0.42),
+               lambda: head(-23, -16, 0.42)):
+        layer = Image.new("RGBA", base.size, CLEAR)
+        c.img = layer
+        c.d = Painter(layer)
+        fn()
+        base.alpha_composite(layer)
+    c.img = base
+    c.d = Painter(base)
+    heart(c, 76, 30, 7, fill=soft)
+    heart(c, 26, 82, 7, fill=soft)
+    paw(c, 52, 58, 0.42, soft)
+    paw(c, 2, 8, 0.42, soft)
+    paw(c, 102, 8, 0.42, soft)
+    c.poly([(54, 4), (56, 10), (62, 12), (56, 14), (54, 20), (52, 14), (46, 12), (52, 10)], fill=soft)
+    c.poly([(4, 54), (6, 58), (10, 60), (6, 62), (4, 66), (2, 62), (-2, 60), (2, 58)], fill=soft)
