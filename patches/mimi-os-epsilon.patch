+    {I18n::Message::SequenceApp, MimiIcons::IconSequence, "Suites"},
+    {I18n::Message::RegressionApp, MimiIcons::IconRegression, "Regressions"},
+    {I18n::Message::InferenceApp, MimiIcons::IconInference, "Inference"},
+    {I18n::Message::FinanceApp, MimiIcons::IconFinance, "Finance"},
+    {I18n::Message::CodeApp, MimiIcons::IconCode, "Python"},
+    {I18n::Message::ElementsApp, MimiIcons::IconElements, "Elements"},
+    {I18n::Message::SettingsApp, MimiIcons::IconSettings, "Parametres"},
+};
+
+constexpr int k_maxBuiltin = 20;
+int8_t s_builtin[k_maxBuiltin];  // app index in AppsContainer
+uint8_t s_builtinIcon[k_maxBuiltin];
+const char* s_builtinLabel[k_maxBuiltin];
+int s_numberOfBuiltin = 0;
+int s_numberOfGames = 0;
+
+// Photo session (simulator only): fake list of apps, no AppsContainer
+bool s_photo = false;
+
+void listApps() {
+  if (s_photo) {
+    return;
+  }
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  int builtin = container->numberOfBuiltinApps();
+  s_numberOfBuiltin = 0;
+  for (int i = 1; i < builtin && s_numberOfBuiltin < k_maxBuiltin; i++) {
+    I18n::Message name = container->appSnapshotAtIndex(
+                             PermutedAppSnapshotIndex(i))
+                             ->descriptor()
+                             ->name();
+    uint8_t icon = MimiIcons::IconGame;
+    const char* label = nullptr;
+    for (const BuiltinArt& a : k_builtinArt) {
+      if (a.name == name) {
+        icon = a.icon;
+        label = a.label;
+      }
+    }
+    s_builtin[s_numberOfBuiltin] = i;
+    s_builtinIcon[s_numberOfBuiltin] = icon;
+    s_builtinLabel[s_numberOfBuiltin] = label ? label : I18n::translate(name);
+    s_numberOfBuiltin++;
+  }
+  s_numberOfGames = container->numberOfApps() - builtin;
+  if (s_numberOfGames < 0) {
+    s_numberOfGames = 0;
+  }
+}
+
+int numberOfItems() { return s_numberOfBuiltin + s_numberOfGames; }
+int numberOfPages() { return (numberOfItems() + k_perPage - 1) / k_perPage; }
+
+const char* itemLabel(int i) {
+  if (i < s_numberOfBuiltin) {
+    return s_builtinLabel[i];
+  }
+  if (s_photo) {
+    return "Mon jeu";
+  }
+  return AppsContainer::sharedAppsContainer()
+      ->externalAppAtIndex(i - s_numberOfBuiltin)
+      .name();
+}
+
+/* --------------------------------------------------------------- state */
+
+struct State {
+  int selected = 0;
+  int page = 0;
+  // Cursor position (top-left of Mimi's head), sliding towards its target
+  float cursorX = -1, cursorY = -1;
+  int phase = 0;        // frames since start (bob, bounce)
+  int bounce = 0;       // frames left of the "boing" of a newly selected tile
+  int blinkIn = 70;     // frames before the next blink
+  int blinking = 0;     // frames left with the eyes closed
+  int hop = 0;          // frames left of the hop when OK is pressed
+  int lastBattery = -1;
+  Rect lastCursor = {0, 0, 0, 0};
+  Rect lastTile = {0, 0, 0, 0};
+};
+
+State s;
+Item s_launch = k_noItem;
+void (*s_invalidate)(Rect) = nullptr;
+
+void invalidate(Rect r) {
+  if (s_invalidate) {
+    s_invalidate(r.intersection(k_screen));
+  }
+}
+
+Rect tileRect(int indexOnPage) {
+  int col = indexOnPage % k_columns, row = indexOnPage / k_columns;
+  return {col * k_columnWidth + (k_columnWidth - k_iconSize) / 2,
+          k_gridTop + row * k_rowHeight, k_iconSize, k_iconSize};
+}
+
+void cursorTarget(float* x, float* y) {
+  Rect t = tileRect(s.selected % k_perPage);
+  *x = t.right() - k_cursorSize + 12;
+  *y = t.y - 12;
+}
+
+int bobOffset() {
+  // A slow up and down, plus the hop when an app opens
+  float bob = 2.f * sinf(s.phase * 0.16f);
+  if (s.hop > 0) {
+    bob -= 7.f * sinf(s.hop * 3.14159f / 8.f);
+  }
+  return static_cast<int>(roundf(bob));
+}
+
+Rect cursorRect() {
+  return {static_cast<int>(roundf(s.cursorX)),
+          static_cast<int>(roundf(s.cursorY)) + bobOffset(), k_cursorSize,
+          k_cursorSize};
+}
+
+int tileLift() {
+  // The selected tile floats up a little, and bounces when just selected
+  float lift = 2.f;
+  if (s.bounce > 0) {
+    lift += 4.f * sinf(s.bounce * 3.14159f / 9.f);
+  }
+  return static_cast<int>(roundf(lift));
+}
+
+int batteryPercent() {
+  if (s_photo) {
+    return 82;
+  }
+  float v = Battery::voltage();
+  int p = static_cast<int>((v - 3.6f) * 100.f / (4.15f - 3.6f));
+  return p < 0 ? 0 : (p > 100 ? 100 : p);
+}
+
+/* ------------------------------------------------------------- drawing */
+
+void drawWallpaper(Band& b) {
+  fill(b, b.clip(), rgb(k_wallBase));
+  const Rect& z = b.clip();
+  constexpr int t = 80;
+  for (int ty = (z.y / t) * t; ty < z.bottom(); ty += t) {
+    for (int tx = (z.x / t) * t; tx < z.right(); tx += t) {
+      tinted(b, MimiIcons::IconWallpaper, tx, ty, rgb(k_wallPattern));
+    }
+  }
+}
+
+void drawBattery(Band& b, int x, int y) {
+  KDColor c = rgb(0xFFFFFF);
+  int pct = batteryPercent();
+  roundFrame(b, {x, y, 21, 11}, 3, c);
+  fill(b, {x + 21, y + 3, 2, 5}, c);
+  int w = (17 * pct + 50) / 100;
+  KDColor level = pct < 20 ? rgb(0xFFE14D) : c;
+  roundFill(b, {x + 2, y + 2, w < 2 ? 2 : w, 7}, 2, level);
+  if (!s_photo && Battery::isCharging()) {
+    image(b, MimiIcons::IconHeartSmall, x - 11, y + 2);
+  }
+}
+
+void drawStatusBar(Band& b) {
+  Rect bar = {0, 0, k_screenWidth, k_statusHeight};
+  if (!bar.intersects(b.clip())) {
+    return;
+  }
+  vgradient(b, bar, rgb(k_pinkBar), rgb(k_pink));
+  fill(b, {0, k_statusHeight - 1, k_screenWidth, 1}, rgb(k_pinkDark), 120);
+  tinted(b, MimiIcons::IconPaw, 6, 4, rgb(0xFFFFFF));
+  text(b, "Mimi-OS", 22, 3, rgb(0xFFFFFF));
+  // Page hearts
+  int pages = numberOfPages();
+  if (pages > 1) {
+    int x = 160 - (pages * 14 - 3) / 2;
+    for (int p = 0; p < pages; p++) {
+      tinted(b,
+             p == s.page ? MimiIcons::IconHeart : MimiIcons::IconHeartOutline,
+             x + p * 14, 5, rgb(0xFFFFFF));
+    }
+  }
+  drawBattery(b, 290, 5);
+}
+
+void drawItemIcon(Band& b, int item, int x, int y) {
+  if (item < s_numberOfBuiltin) {
+    image(b, s_builtinIcon[item], x, y);
+    return;
+  }
+  // A game: its own icon on a pink rounded frame, with Mimi's heart clip
+  Rect r = {x + 3, y + 3, k_iconSize - 6, k_iconSize - 6};
+  roundFill(b, r.inset(-2), 11, rgb(k_pink));
+  if (s_photo) {
+    image(b, MimiIcons::IconGame, x, y);
+    return;
+  }
+  gameIcon(b,
+           AppsContainer::sharedAppsContainer()->externalAppAtIndex(
+               item - s_numberOfBuiltin),
+           r.x, r.y, r.w);
+  roundFrame(b, r.inset(-2), 11, rgb(k_pink));
+  roundFrame(b, r.inset(-1), 10, rgb(k_pink));
+  image(b, MimiIcons::IconHeart, r.right() - 8, r.y - 3);
+}
+
+void drawGrid(Band& b) {
+  int first = s.page * k_perPage;
+  int count = numberOfItems() - first;
+  if (count > k_perPage) {
+    count = k_perPage;
+  }
+  for (int i = 0; i < count; i++) {
+    Rect t = tileRect(i);
+    bool selected = first + i == s.selected;
+    int lift = selected ? tileLift() : 0;
+    if (!t.inset(-8).translated(0, -lift).intersects(b.clip()) &&
+        !t.inset(-8).intersects(b.clip())) {
+      continue;
+    }
+    if (selected) {
+      Rect halo = t.inset(-5);
+      roundFill(b, halo.translated(0, 2), 15, rgb(k_pinkDark), 50);
+      roundFill(b, halo, 15, rgb(k_halo), 200);
+      roundFrame(b, halo, 15, rgb(k_pink));
+      roundFrame(b, halo.inset(1), 14, rgb(k_pink), 140);
+      // sparkles around the halo
+      int tw = (s.phase / 6) % 2;
+      tinted(b, MimiIcons::IconSparkle, halo.x - 4, halo.bottom() - 10,
+             rgb(0xFFFFFF), tw ? 256 : 120);
+      tinted(b, MimiIcons::IconSparkle, halo.x - 2, halo.y + 6,
+             rgb(k_pink), tw ? 110 : 230);
+    } else {
+      // soft shadow under the other tiles
+      roundFill(b, {t.x + 4, t.bottom() - 4, t.w - 8, 5}, 2, rgb(k_pinkDark),
+                40);
+    }
+    drawItemIcon(b, first + i, t.x, t.y - lift);
+  }
+}
+
+void drawBottom(Band& b) {
+  Rect area = {0, k_bottomTop, k_screenWidth, k_screenHeight - k_bottomTop};
+  if (!area.intersects(b.clip())) {
+    return;
+  }
+  // Mimi, a bit bigger, saying the name of the selected app
+  bool closed = s.blinking > 0;
+  image(b, closed ? MimiIcons::IconMimiBlink : MimiIcons::IconMimi, k_mimiX,
+        k_mimiY);
+  Rect r = k_bubble;
+  roundFill(b, r.translated(0, 2), 16, rgb(k_pinkDark), 50);
+  // tail of the bubble, pointing at Mimi
+  for (int i = 0; i < 8; i++) {
+    fill(b, {r.x - 8 + i, r.y + 16 - i / 2, 1, 4 + i}, rgb(0xFFFFFF));
+  }
+  roundFill(b, r, 16, rgb(0xFFFFFF));
+  roundFrame(b, r, 16, rgb(k_pink));
+  const char* label = numberOfItems() > 0 ? itemLabel(s.selected) : "";
+  int tw = textWidth(label, KDFont::Size::Large);
+  int maxW = r.w - 40;
+  if (tw > maxW) {
+    tw = maxW;
+  }
+  int tx = r.x + (r.w - tw - 16) / 2;
+  text(b, label, tx, r.y + 9, rgb(k_pinkDark), KDFont::Size::Large,
+       Align::Left, maxW);
+  image(b, MimiIcons::IconHeart, tx + tw + 5, r.y + 13);
+}
+
+void drawCursor(Band& b) {
+  if (numberOfItems() == 0) {
+    return;
+  }
+  Rect c = cursorRect();
+  if (!c.intersects(b.clip())) {
+    return;
+  }
+  bool closed = s.blinking > 0;
+  image(b, closed ? MimiIcons::IconCursorBlink : MimiIcons::IconCursor, c.x,
+        c.y);
+}
+
+Rect selectedTileArea() {
+  if (numberOfItems() == 0) {
+    return {0, 0, 0, 0};
+  }
+  Rect t = tileRect(s.selected % k_perPage).inset(-14);
+  return {t.x, t.y - 8, t.w, t.h + 8};
+}
+
+/* ------------------------------------------------------------- actions */
+
+void select(int index, bool animate = true) {
+  int n = numberOfItems();
+  if (n == 0) {
+    return;
+  }
+  if (index < 0) {
+    index = 0;
+  }
+  if (index >= n) {
+    index = n - 1;
+  }
+  if (index == s.selected) {
+    return;
+  }
+  invalidate(selectedTileArea());
+  int page = index / k_perPage;
+  s.selected = index;
+  s.bounce = 9;
+  if (page != s.page) {
+    s.page = page;
+    float x, y;
+    cursorTarget(&x, &y);
+    s.cursorX = x;
+    s.cursorY = y;
+    invalidate(k_screen);
+    return;
+  }
+  if (!animate) {
+    cursorTarget(&s.cursorX, &s.cursorY);
+  }
+  invalidate(selectedTileArea());
+  invalidate(k_bubble.inset(-2));
+}
+
+void moveBy(int dx, int dy) {
+  int n = numberOfItems();
+  int i = s.selected;
+  int onPage = i % k_perPage;
+  int col = onPage % k_columns, row = onPage / k_columns;
+  if (dx != 0) {
+    select(i + dx);
+    return;
+  }
+  int target = i + dy * k_columns;
+  if (dy > 0 && row == k_rows - 1) {
+    // next page, same column
+    target = (s.page + 1) * k_perPage + col;
+  } else if (dy < 0 && row == 0) {
+    if (s.page == 0) {
+      return;
+    }
+    target = (s.page - 1) * k_perPage + (k_rows - 1) * k_columns + col;
+  }
+  if (target >= n) {
+    // the row below is short: go to its last tile, if it exists
+    int lastPageStart = (target / k_perPage) * k_perPage;
+    int lastRowStart = lastPageStart + ((target % k_perPage) / k_columns) * k_columns;
+    if (lastRowStart >= n) {
+      return;
+    }
+    target = n - 1;
+  }
+  select(target);
+}
+
+}  // namespace
+
+/* --------------------------------------------------------------- shell */
+
+namespace Shell {
+
+#if !PLATFORM_DEVICE
+void photoSession();
+#endif
+
+void setInvalidator(void (*inv)(Rect)) { s_invalidate = inv; }
+
+void enter() {
+  listApps();
+  int n = numberOfItems();
+  if (s.selected >= n) {
+    s.selected = n > 0 ? n - 1 : 0;
+  }
+  s.page = s.selected / k_perPage;
+  cursorTarget(&s.cursorX, &s.cursorY);
+  s.hop = 0;
+  s.lastCursor = cursorRect();
+  s.lastTile = selectedTileArea();
+#if !PLATFORM_DEVICE
+  static bool s_photoDone = false;
+  if (!s_photoDone && getenv("MIMI_SHOTS")) {
+    s_photoDone = true;
+    photoSession();
+    listApps();
+  }
+#endif
+}
+
+Item takeLaunch() {
+  Item it = s_launch;
+  s_launch = k_noItem;
+  return it;
+}
+
+bool handleEvent(Event e) {
+  if (!e.isKeyboardEvent() || e == Events::OnOff) {
+    return false;
+  }
+  if (e == Events::Right) {
+    moveBy(1, 0);
+  } else if (e == Events::Left) {
+    moveBy(-1, 0);
+  } else if (e == Events::Down) {
+    moveBy(0, 1);
+  } else if (e == Events::Up) {
+    moveBy(0, -1);
+  } else if (e == Events::Home || e == Events::Back) {
+    select(0, false);
+  } else if (e == Events::OK || e == Events::EXE) {
+    if (numberOfItems() == 0) {
+      return true;
+    }
+    if (s.selected < s_numberOfBuiltin) {
+      s_launch = {Item::Kind::Builtin, s_builtin[s.selected]};
+    } else {
+      s_launch = {Item::Kind::External,
+                  static_cast<int16_t>(s.selected - s_numberOfBuiltin)};
+    }
+    s.hop = 8;
+  } else {
+    // Keys 1 to 9 select an app, 0 the settings, like on the official home
+    const char* t = e.text();
+    if (t && t[0] >= '0' && t[0] <= '9' && t[1] == 0) {
+      int index = t[0] == '0' ? s_numberOfBuiltin - 1 : t[0] - '1';
+      if (index < numberOfItems()) {
+        if (index == s.selected) {
+          return handleEvent(Events::OK);
+        }
+        select(index);
+      }
+      return true;
+    }
+    return false;
+  }
+  return true;
+}
+
+bool tick() {
+  int battery = batteryPercent();
+  if (battery != s.lastBattery) {
+    s.lastBattery = battery;
+    invalidate({270, 0, 50, k_statusHeight});
+  }
+  return false;
+}
+
+int framePeriod() { return k_framePeriod; }
+
+bool frame() {
+  s.phase++;
+  if (s.bounce > 0) {
+    s.bounce--;
+  }
+  if (s.hop > 0) {
+    s.hop--;
+  }
+  // Blink every few seconds
+  bool blinkChanged = false;
+  if (s.blinking > 0) {
+    if (--s.blinking == 0) {
+      blinkChanged = true;
+    }
+  } else if (--s.blinkIn <= 0) {
+    s.blinking = 4;
+    s.blinkIn = 60 + (s.phase * 37) % 70;
+    blinkChanged = true;
+  }
+  if (blinkChanged) {
+    invalidate({k_mimiX, k_mimiY, 46, 46});
+  }
+  // The cursor slides towards the selected tile
+  float tx, ty;
+  cursorTarget(&tx, &ty);
+  s.cursorX += (tx - s.cursorX) * 0.38f;
+  s.cursorY += (ty - s.cursorY) * 0.38f;
+  if (fabsf(tx - s.cursorX) < 0.5f && fabsf(ty - s.cursorY) < 0.5f) {
+    s.cursorX = tx;
+    s.cursorY = ty;
+  }
+  Rect c = cursorRect();
+  if (c.x != s.lastCursor.x || c.y != s.lastCursor.y || blinkChanged) {
+    invalidate(s.lastCursor);
+    invalidate(c);
+    s.lastCursor = c;
+  }
+  // Bounce of the selected tile and its sparkles
+  Rect tile = selectedTileArea();
+  if (s.bounce > 0 || (s.phase % 6) == 0) {
+    invalidate(tile);
+  }
+  s.lastTile = tile;
+  return false;
+}
+
+void render(Band& b) {
+  drawWallpaper(b);
+  drawGrid(b);
+  drawBottom(b);
+  drawStatusBar(b);
+  drawCursor(b);
+}
+
+/* ------------------------------------------------- photos (simulator) */
+
+#if !PLATFORM_DEVICE
+
+namespace {
+
+uint16_t s_shot[k_screenWidth * k_screenHeight];
+int s_gifFrame = 0;
+
+void shoot(const char* name) {
+  Band band;
+  for (int y = 0; y < k_screenHeight; y += Band::k_maxHeight) {
+    Rect area = {0, y, k_screenWidth, Band::k_maxHeight};
+    band.begin(area);
+    render(band);
+    for (int j = 0; j < Band::k_maxHeight; j++) {
+      const KDColor* row = band.pixels() + j * k_screenWidth;
+      for (int i = 0; i < k_screenWidth; i++) {
+        s_shot[(y + j) * k_screenWidth + i] = static_cast<uint16_t>(row[i]);
+      }
+    }
+  }
+  char path[512];
+  snprintf(path, sizeof(path), "%s/%s.raw", getenv("MIMI_SHOTS"), name);
+  FILE* f = fopen(path, "wb");
+  if (f) {
+    fwrite(s_shot, 2, k_screenWidth * k_screenHeight, f);
+    fclose(f);
+  }
+}
+
+void wait(int frames, const char* gif = nullptr) {
+  for (int i = 0; i < frames; i++) {
+    frame();
+    if (gif) {
+      char name[64];
+      snprintf(name, sizeof(name), "%s_%04d", gif, s_gifFrame++);
+      shoot(name);
+    }
+  }
+}
+
+void key(Event e, int frames, const char* gif = nullptr) {
+  handleEvent(e);
+  takeLaunch();
+  wait(frames, gif);
+}
+
+}  // namespace
+
+void photoSession() {
+  // Same apps as on the calculator, plus two games
+  s_photo = true;
+  s_numberOfBuiltin = 0;
+  for (const BuiltinArt& a : k_builtinArt) {
+    s_builtin[s_numberOfBuiltin] = s_numberOfBuiltin + 1;
+    s_builtinIcon[s_numberOfBuiltin] = a.icon;
+    s_builtinLabel[s_numberOfBuiltin] = a.label;
+    s_numberOfBuiltin++;
+  }
+  s_numberOfGames = 2;
+  State saved = s;
+  s = State();
+  s.blinkIn = 1000;
+  cursorTarget(&s.cursorX, &s.cursorY);
+  wait(3);
+  shoot("accueil");
+  key(Events::Right, 10);
+  key(Events::Right, 10);
+  key(Events::Right, 10);
+  key(Events::Down, 12);
+  shoot("selection");
+  s.blinking = 3;
+  shoot("clin_doeil");
+  s.blinking = 0;
+  key(Events::Down, 10);
+  key(Events::Down, 14);
+  shoot("jeux");
+  // GIF: Mimi moves from tile to tile
+  s = State();
+  s.blinkIn = 1000;
+  cursorTarget(&s.cursorX, &s.cursorY);
+  wait(8, "gifaccueil");
+  Event path[] = {Events::Right, Events::Right, Events::Down, Events::Left,
+                  Events::Down,  Events::Right, Events::Right, Events::Up,
+                  Events::Up};
+  for (Event e : path) {
+    key(e, 9, "gifaccueil");
+  }
+  s.blinking = 4;
+  wait(10, "gifaccueil");
+  s = saved;
+  s_photo = false;
+  if (getenv("MIMI_SHOTS_EXIT")) {
+    exit(0);
+  }
+}
+
+#endif
+
+}  // namespace Shell
+
+}  // namespace Mimi
+}  // namespace Home
