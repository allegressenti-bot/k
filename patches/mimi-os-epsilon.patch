@@ -0,0 +1,572 @@
+#!/usr/bin/env python3
+"""Generate the Mimi-OS pictures for the NumWorks home screen.
+
+Mimi is an original character made for this project: an apricot tabby
+kitten with three stripes on her forehead, big sparkly eyes, a little
+"w" mouth, rosy cheeks and a pink heart clip on her ear.
+
+Everything is drawn as vector shapes in a 100x100 design space and rendered
+with 8x supersampling, then exported as RGB565 + 8-bit alpha:
+
+  - app icons (46 px): a candy pink tile with kitten ears and whiskers,
+    the app's symbol on it, and Mimi's heart clip;
+  - Mimi's head for the cursor (28 px) and for the speech bubble (46 px),
+    eyes open and closed (blink);
+  - hearts and paws (status bar, page dots, sparkles);
+  - the wallpaper tile (80 px): faint kitten heads, hearts and paws.
+
+Usage: gen_icons.py <output_header.h> [--preview preview.png]
+"""
+
+import math
+import sys
+
+from PIL import Image, ImageDraw, ImageFont
+
+SS = 8
+D = 100
+
+FONT_PATHS = [
+    ("/System/Library/Fonts/Supplemental/Arial Rounded Bold.ttf", 0),
+    ("/System/Library/Fonts/Helvetica.ttc", 1),
+    ("/System/Library/Fonts/Supplemental/Arial Bold.ttf", 0),
+    ("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 0),
+]
+
+
+def font(size):
+    for path, index in FONT_PATHS:
+        try:
+            return ImageFont.truetype(path, size, index=index)
+        except Exception:
+            continue
+    return ImageFont.load_default()
+
+
+def hexc(v, a=255):
+    return ((v >> 16) & 255, (v >> 8) & 255, v & 255, a)
+
+
+WHITE = hexc(0xFFFFFF)
+CLEAR = (0, 0, 0, 0)
+
+# Mimi's colours
+FUR = 0xFFD9B3        # apricot
+FUR_DARK = 0xF2A66E   # stripes
+INK = 0x5B3440        # outline, eyes (a soft plum brown, never black)
+EAR_IN = 0xFFA3C4
+BLUSH = 0xFF8FB5
+HEART = 0xFF3F8E
+HEART_DARK = 0xC81E64
+
+# Theme pinks
+PINK = 0xFF6FA8
+PINK_DARK = 0xE04A8A
+PINK_LIGHT = 0xFFC2DA
+
+
+class Painter:
+    """ImageDraw replaces pixels: translucent shapes are drawn on a layer and
+    composited over the picture instead."""
+
+    def __init__(self, img):
+        self.img = img
+        self.base = ImageDraw.Draw(img)
+
+    def __getattr__(self, method):
+        def paint(*args, **kwargs):
+            colours = [kwargs.get("fill"), kwargs.get("outline")]
+            translucent = any(isinstance(c, tuple) and len(c) == 4 and 0 < c[3] < 255
+                              for c in colours)
+            if not translucent:
+                return getattr(self.base, method)(*args, **kwargs)
+            layer = Image.new("RGBA", self.img.size, CLEAR)
+            getattr(ImageDraw.Draw(layer), method)(*args, **kwargs)
+            self.img.alpha_composite(layer)
+        return paint
+
+
+class Canvas:
+    def __init__(self, w=D, h=D):
+        self.w, self.h = w, h
+        self.img = Image.new("RGBA", (w * SS, h * SS), CLEAR)
+        self.d = Painter(self.img)
+
+    def s(self, v):
+        return v * SS
+
+    def box(self, x0, y0, x1, y1):
+        return [self.s(x0), self.s(y0), self.s(x1), self.s(y1)]
+
+    def rrect(self, x0, y0, x1, y1, r, fill=WHITE, outline=None, width=0):
+        self.d.rounded_rectangle(self.box(x0, y0, x1, y1), radius=self.s(r),
+                                 fill=fill, outline=outline,
+                                 width=int(round(self.s(width))) if width else 0)
+
+    def rect(self, x0, y0, x1, y1, fill=WHITE):
+        self.d.rectangle(self.box(x0, y0, x1, y1), fill=fill)
+
+    def circle(self, cx, cy, r, fill=WHITE, outline=None, width=0):
+        self.d.ellipse(self.box(cx - r, cy - r, cx + r, cy + r), fill=fill,
+                       outline=outline,
+                       width=int(round(self.s(width))) if width else 0)
+
+    def ellipse(self, x0, y0, x1, y1, fill=WHITE, outline=None, width=0):
+        self.d.ellipse(self.box(x0, y0, x1, y1), fill=fill, outline=outline,
+                       width=int(round(self.s(width))) if width else 0)
+
+    def poly(self, pts, fill=WHITE, outline=None, width=0):
+        self.d.polygon([(self.s(x), self.s(y)) for x, y in pts], fill=fill,
+                       outline=outline,
+                       width=int(round(self.s(width))) if width else 0)
+
+    def line(self, pts, width, fill=WHITE, round_caps=True):
+        p = [(self.s(x), self.s(y)) for x, y in pts]
+        w = int(round(self.s(width)))
+        self.d.line(p, fill=fill, width=w, joint="curve")
+        if round_caps:
+            for x, y in (p[0], p[-1]):
+                self.d.ellipse([x - w / 2, y - w / 2, x + w / 2, y + w / 2], fill=fill)
+
+    def arc(self, cx, cy, r, a0, a1, width, fill=WHITE):
+        self.d.arc(self.box(cx - r, cy - r, cx + r, cy + r), a0, a1, fill=fill,
+                   width=int(round(self.s(width))))
+
+    def text(self, cx, cy, t, size, fill=WHITE):
+        f = font(int(self.s(size)))
+        self.d.text((self.s(cx), self.s(cy)), t, font=f, fill=fill, anchor="mm")
+
+    def render(self, w, h=None):
+        if h is None:
+            h = round(w * self.h / self.w)
+        return self.img.resize((w, h), Image.LANCZOS)
+
+
+# ----------------------------------------------------------------- shapes
+
+def heart_pts(cx, cy, s, n=80):
+    """A heart of about 2s wide, centred on (cx, cy)."""
+    pts = []
+    for i in range(n):
+        t = i / n * 2 * math.pi
+        x = 16 * math.sin(t) ** 3
+        y = 13 * math.cos(t) - 5 * math.cos(2 * t) - 2 * math.cos(3 * t) - math.cos(4 * t)
+        pts.append((cx + x * s / 16, cy - y * s / 16 - s * 0.1))
+    return pts
+
+
+def heart(c, cx, cy, s, fill=hexc(HEART), outline=None, width=0):
+    c.poly(heart_pts(cx, cy, s), fill=fill, outline=outline, width=width)
+
+
+def paw(c, cx, cy, s, fill):
+    c.ellipse(cx - 9 * s, cy - 4 * s, cx + 9 * s, cy + 10 * s, fill=fill)
+    for dx, dy in ((-11, -9), (-4, -15), (4, -15), (11, -9)):
+        c.circle(cx + dx * s, cy + dy * s, 3.6 * s, fill=fill)
+
+
+def ear(c, pts, fill, inner, ink, width):
+    c.poly(pts, fill=fill, outline=ink, width=width)
+    (x0, y0), (x1, y1), (x2, y2) = pts
+    mx, my = (x0 + x1 + x2) / 3, (y0 + y1 + y2) / 3
+    k = 0.55
+    c.poly([(mx + (x - mx) * k, my + (y - my) * k + 2) for x, y in pts], fill=inner)
+
+
+def mimi(c, cx, cy, s, blink=False, ink_w=3.2, clip=True):
+    """Mimi's head, about 84*s wide, centred on (cx, cy)."""
+    ink = hexc(INK)
+    w = ink_w * s if ink_w else 0
+    # ears (rounded tips: drawn as triangles under the head)
+    ear(c, [(cx - 40 * s, cy - 6 * s), (cx - 34 * s, cy - 44 * s), (cx - 6 * s, cy - 28 * s)],
+        hexc(FUR), hexc(EAR_IN), ink, w)
+    ear(c, [(cx + 40 * s, cy - 6 * s), (cx + 34 * s, cy - 44 * s), (cx + 6 * s, cy - 28 * s)],
+        hexc(FUR), hexc(EAR_IN), ink, w)
+    # head: a wide soft oval
+    c.ellipse(cx - 42 * s, cy - 33 * s, cx + 42 * s, cy + 31 * s, fill=hexc(FUR),
+              outline=ink, width=w)
+    # tabby stripes on the forehead
+    for dx, h in ((-9, 11), (0, 14), (9, 11)):
+        c.line([(cx + dx * s, cy - 31 * s), (cx + dx * s * 0.8, cy - (31 - h) * s)], 4 * s,
+               fill=hexc(FUR_DARK))
+    # cheeks
+    c.ellipse(cx - 34 * s, cy + 6 * s, cx - 20 * s, cy + 14 * s, fill=hexc(BLUSH, 200))
+    c.ellipse(cx + 20 * s, cy + 6 * s, cx + 34 * s, cy + 14 * s, fill=hexc(BLUSH, 200))
+    # eyes: big and sparkly, or closed (happy arcs)
+    for ex in (cx - 17 * s, cx + 17 * s):
+        if blink:
+            c.arc(ex, cy - 1 * s, 7 * s, 200, 340, 3.2 * s, fill=ink)
+        else:
+            c.ellipse(ex - 7 * s, cy - 11 * s, ex + 7 * s, cy + 7 * s, fill=ink)
+            c.circle(ex + 2.5 * s, cy - 5.5 * s, 3 * s, fill=WHITE)
+            c.circle(ex - 2.5 * s, cy + 2.5 * s, 1.5 * s, fill=WHITE)
+    # heart nose and "w" mouth
+    heart(c, cx, cy + 9 * s, 4.2 * s, fill=hexc(HEART))
+    mw = max(2.2 * s, 1.6)
+    c.arc(cx - 4 * s, cy + 13 * s, 4 * s, 10, 170, mw, fill=ink)
+    c.arc(cx + 4 * s, cy + 13 * s, 4 * s, 10, 170, mw, fill=ink)
+    # whiskers: two short ones on each side
+    for side in (-1, 1):
+        for dy, tilt in ((4, -3), (11, 2)):
+            x0 = cx + side * 43 * s
+            c.line([(x0, cy + dy * s), (x0 + side * 11 * s, cy + (dy + tilt) * s)],
+                   2.2 * s, fill=ink)
+    # heart clip on her right ear (our left)
+    if clip:
+        heart(c, cx - 27 * s, cy - 28 * s, 13 * s, fill=hexc(HEART), outline=hexc(HEART_DARK),
+              width=2 * s)
+        c.circle(cx - 31 * s, cy - 33 * s, 3 * s, fill=hexc(0xFFFFFF, 200))
+
+
+# -------------------------------------------------------------- app tiles
+
+def tile(c, top, bottom):
+    """Candy tile with kitten ears and whiskers: everything but the symbol."""
+    layer = Image.new("RGBA", c.img.size, CLEAR)
+    mask = Image.new("L", c.img.size, 0)
+    md = ImageDraw.Draw(mask)
+    s = c.s
+    md.rounded_rectangle([s(8), s(18), s(92), s(96)], radius=s(24), fill=255)
+    md.polygon([(s(12), s(46)), (s(15), s(4)), (s(46), s(22))], fill=255)
+    md.polygon([(s(88), s(46)), (s(85), s(4)), (s(54), s(22))], fill=255)
+    # rounded ear tips
+    md.ellipse([s(11), s(2), s(21), s(12)], fill=255)
+    md.ellipse([s(79), s(2), s(89), s(12)], fill=255)
+    t, b = hexc(top), hexc(bottom)
+    grad = Image.new("RGBA", c.img.size)
+    gd = ImageDraw.Draw(grad)
+    for y in range(c.img.size[1]):
+        k = y / (c.img.size[1] - 1)
+        gd.line([(0, y), (c.img.size[0], y)], fill=tuple(int(t[i] + (b[i] - t[i]) * k) for i in range(4)))
+    layer.paste(grad, (0, 0), mask)
+    c.img.alpha_composite(layer)
+    # inner ears
+    c.poly([(19, 36), (20, 12), (38, 24)], fill=hexc(0xFFFFFF, 120))
+    c.poly([(81, 36), (80, 12), (62, 24)], fill=hexc(0xFFFFFF, 120))
+    # glossy top light
+    c.ellipse(20, 22, 80, 44, fill=hexc(0xFFFFFF, 45))
+    # whiskers on the sides
+    for side in (-1, 1):
+        for dy, tilt in ((60, -3), (70, 3)):
+            x0 = 50 + side * 37
+            c.line([(x0, dy), (x0 + side * 9, dy + tilt)], 2.6, fill=hexc(0xFFFFFF, 220))
+
+
+def tile_clip(c):
+    heart(c, 80, 26, 11, fill=hexc(HEART), outline=hexc(0xFFFFFF), width=2.4)
+
+
+def outlined_text(c, cx, cy, t, size, fill=WHITE):
+    c.text(cx, cy + 1.6, t, size, fill=hexc(INK, 70))
+    c.text(cx, cy, t, size, fill=fill)
+
+
+PALETTES = {
+    "pink": (0xFF9CC6, 0xFF5E9E),
+    "rose": (0xFFB0C8, 0xF26591),
+    "berry": (0xF59AD6, 0xD9549F),
+    "peach": (0xFFB8A8, 0xFF7A8E),
+    "lilac": (0xE3A8F0, 0xC170D8),
+    "candy": (0xFFA6D9, 0xF06AB4),
+}
