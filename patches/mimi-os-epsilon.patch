+KDColor mix(uint32_t a, uint32_t b, int t256) {
+  int ra = (a >> 16) & 255, ga = (a >> 8) & 255, ba = a & 255;
+  int rb = (b >> 16) & 255, gb = (b >> 8) & 255, bb = b & 255;
+  return KDColor::RGB888(static_cast<uint8_t>(ra + (rb - ra) * t256 / 256),
+                         static_cast<uint8_t>(ga + (gb - ga) * t256 / 256),
+                         static_cast<uint8_t>(ba + (bb - ba) * t256 / 256));
+}
