+#pragma once
+
+#include <ion/events.h>
+
+#include "gfx.h"
+
+namespace Home {
+namespace Mimi {
+
+/* Something to start from the home screen: a calculator app or an external
+ * app (.nwa game). */
+struct Item {
+  enum class Kind : uint8_t { None, Builtin, External };
+  Kind kind;
+  int16_t index;  // app index in AppsContainer, or external app index
+  bool isNone() const { return kind == Kind::None; }
+};
+
+constexpr Item k_noItem = {Item::Kind::None, 0};
+
+/* The Mimi-OS home screen. Its state is static: it survives leaving the home
+ * app to run a calculator app or a game. */
+namespace Shell {
+
+// The home app became active: refresh the list of apps and games
+void enter();
+// Returns true if the event was used
+bool handleEvent(Ion::Events::Event event);
+// Called every Escher tick. Returns true to redraw.
+bool tick();
+// Animation period in ms
+int framePeriod();
+// One animation step. Returns true to redraw.
+bool frame();
+// Draws everything that intersects the band
+void render(Band& band);
+// An app to open, set by handleEvent; the caller opens it right away
+Item takeLaunch();
+// Where invalidated rectangles go (the home view)
+void setInvalidator(void (*invalidate)(Rect));
+
+}  // namespace Shell
+
+}  // namespace Mimi
